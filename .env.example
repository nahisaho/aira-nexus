# Copy to .env; never commit .env. Set real application IDs, not client secrets.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
PUBLIC_ORIGIN=http://localhost:5173
PORT=3000
# Required for SSH-only proxy verification. Unset retains legacy public binding.
BIND_HOST=127.0.0.1

# Local development only. Generate a random password and URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://aira:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/aira_nexus

# Optional user-owned GitHub device authentication: set BOTH or leave BOTH absent.
# Register your own OAuth App and enable device flow; no client secret is needed.
# GITHUB_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_OAUTH_APP_CLIENT_ID
# COPILOT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_CANONICAL_BASE64_OF_32_RANDOM_BYTES

# Optional private project files. Leave ALL file-storage settings absent until enabled.
# Apply migration004 with an approved backup first. Never use development keys in Azure.
# Local development: generate a fresh canonical base64 key from64 random bytes.
# Start the separately approved emulator with: docker compose --profile files up -d blob
# FILE_STORAGE_MODE=azurite
# AZURITE_BLOB_ENDPOINT=http://127.0.0.1:10000/airanexus
# AZURITE_ACCOUNT_NAME=airanexus
# AZURITE_ACCOUNT_KEY=REPLACE_WITH_CANONICAL_BASE64_OF_64_RANDOM_BYTES
# AZURE_STORAGE_CONTAINER=aira-nexus

# Production alternative: managed identity only; no connection string, key or SAS.
# FILE_STORAGE_MODE=azure
# AZURE_STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=aira-nexus
# AZURE_MANAGED_IDENTITY_CLIENT_ID=OPTIONAL_USER_ASSIGNED_IDENTITY_CLIENT_ID

# Durable jobs are disabled by default; live migration005 needs separate consent.
# The chat handler is registered only when CHAT_ENABLED=true, which also requires Copilot configuration.
# JOBS_ENABLED=false
# CHAT_ENABLED=false

# Project pins are disabled by default; apply migration006 with separate approval first.
# Independent of durable jobs/migration005. Only exact true or false is accepted.
# PROJECT_PINS_ENABLED=false
