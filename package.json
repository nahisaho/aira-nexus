{
  "name": "aira-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/copy-pdf-assets.mjs && node scripts/build-markdown-renderer.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "jobs:worker": "node --env-file-if-exists=.env dist/server/jobs/index.js",
    "dev:jobs": "tsx --env-file-if-exists=.env src/server/jobs/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "proxy:up": "sh scripts/proxy.sh up",
    "proxy:stop": "sh scripts/proxy.sh stop",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write src tests scripts db docs .consulting .sdd/specs *.json *.md *.ts *.yml .env.example .gitignore",
    "format:check": "prettier --check src tests scripts db docs .consulting .sdd/specs *.json *.md *.ts *.yml"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/msal-browser": "^4.27.0",
    "@azure/storage-blob": "12.33.0",
    "@github/copilot-sdk": "1.0.31",
    "@hono/node-server": "^2.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "domhandler": "5.0.3",
    "hono": "^4.10.0",
    "htmlparser2": "10.0.0",
    "jose": "^6.1.0",
    "katex": "0.16.25",
    "lucide-react": "^0.468.0",
    "mermaid": "11.12.2",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.16.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "saxes": "6.0.0",
    "tailwind-merge": "^3.4.0",
    "unified": "11.0.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "0.16.7",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "playwright": "^1.65.1",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
